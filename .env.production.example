# Incognito — Production Environment Configuration
# NEVER commit real credentials to source control. Inject via Vault / AWS Secrets Manager / GCP Secret Manager.
NODE_ENV=production
PORT=4000
CORS_ORIGINS=https://incognito.institutional.edu

# Production PostgreSQL Database (SSL required)
DATABASE_URL=postgresql://incognito_prod_app:STRONG_PRODUCTION_DB_PASSWORD@postgres.prod.internal:5432/incognito_prod_db?sslmode=verify-full

# Production Cloud KMS Managed Master Key (Strictly >= 32 bytes, NEVER default/dev strings)
ENCRYPTION_KEY=INJECTED_VIA_PRODUCTION_KMS_SECRET_MANAGER_32_BYTES_MIN!

# Production JWT Signing Secret
AUTH_SECRET=INJECTED_VIA_PRODUCTION_VAULT_MINIMUM_64_CHARACTERS_CRYPTO_KEY!
AUTH_PROVIDER=jwt

# Institutional OpenID Connect (Entra ID / Google Workspace)
OIDC_ISSUER_URL=https://login.microsoftonline.com/production-tenant-id/v2.0
OIDC_CLIENT_ID=production-client-id
OIDC_CLIENT_SECRET=production-client-secret-from-vault
OIDC_ALLOWED_DOMAINS=university.edu,alumni.university.edu

# Production AI Moderation Pipeline (Backend-Only, Minimum Data Principle)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=PRODUCTION_GEMINI_API_KEY_FROM_VAULT
OPENAI_API_KEY=PRODUCTION_OPENAI_FALLBACK_API_KEY_FROM_VAULT

# Production Blockchain Audit Registry (Ethereum Mainnet / Arbitrum One / Optimism)
BLOCKCHAIN_NETWORK=Arbitrum One
CONTRACT_ADDRESS=0xDEPLOYED_PRODUCTION_AUDIT_REGISTRY_CONTRACT_ADDRESS
BLOCKCHAIN_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/PRODUCTION_ALCHEMY_KEY
BLOCKCHAIN_BACKUP_RPC_URL=https://arbitrum-mainnet.infura.io/v3/PRODUCTION_INFURA_KEY
BLOCKCHAIN_PRIVATE_KEY=DEDICATED_INSTITUTIONAL_RELAYER_KEY_NO_PERSONAL_FUNDS
