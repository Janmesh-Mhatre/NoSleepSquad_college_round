# Incognito — Staging Environment Configuration
NODE_ENV=staging
PORT=4000
CORS_ORIGINS=https://staging.incognito.institutional.edu

# PostgreSQL Staging Connection
DATABASE_URL=postgresql://incognito_staging_app:SECURE_STAGING_PASSWORD@postgres.staging.internal:5432/incognito_staging_db

# KMS-Injected Encryption Key (Minimum 32 bytes)
ENCRYPTION_KEY=staging-kms-managed-authenticated-encryption-key-32b!

# Authentication & Institutional OIDC
AUTH_SECRET=staging-auth-secret-token-signing-key-minimum-32-chars!
AUTH_PROVIDER=jwt
OIDC_ISSUER_URL=https://login.microsoftonline.com/staging-tenant-id/v2.0
OIDC_CLIENT_ID=staging-client-id-here
OIDC_ALLOWED_DOMAINS=staging.university.edu

# AI Moderation Providers
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=STAGING_GEMINI_API_KEY_HERE
OPENAI_API_KEY=OPTIONAL_STAGING_BACKUP_KEY

# Blockchain Audit Anchoring (Sepolia Testnet)
BLOCKCHAIN_NETWORK=Sepolia Testnet
CONTRACT_ADDRESS=0x742d35Cc6634C0532925a3b844Bc454e4438f44e
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/STAGING_ALCHEMY_KEY
BLOCKCHAIN_BACKUP_RPC_URL=https://sepolia.infura.io/v3/STAGING_INFURA_KEY
BLOCKCHAIN_PRIVATE_KEY=STAGING_DEDICATED_RELAYER_WALLET_PRIVATE_KEY
