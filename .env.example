# ==============================================================================
# INCOGNITO ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local to configure your local or deployment environment.

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# Base URL of the running Incognito backend API.
# In development, typically: http://localhost:4000/api
# If left blank, frontend calls fail gracefully with "backend_not_configured"
VITE_API_BASE=http://localhost:4000/api

# ------------------------------------------------------------------------------
# BACKEND SERVER CONFIGURATION (Express / Node.js)
# ------------------------------------------------------------------------------
# Port for the HTTP backend API server
PORT=4000

# Node execution environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Allowed CORS origins (comma-separated if multiple)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SQLite database file path (relative or absolute)
DATABASE_PATH=./incognito.sqlite

# ------------------------------------------------------------------------------
# SECURITY & CRYPTOGRAPHY CONFIGURATION
# ------------------------------------------------------------------------------
# Master secret or key used to derive AES-256-GCM report payload cipher keys at rest.
# Must be kept confidential and securely managed in institutional key vaults in production.
ENCRYPTION_KEY=incognito-default-dev-secret-key-32b-min

# ------------------------------------------------------------------------------
# ANCHORING & BLOCKCHAIN CONFIGURATION (Optional / Simulation)
# ------------------------------------------------------------------------------
# Target network for Merkle root public integrity anchoring
BLOCKCHAIN_NETWORK=polygon-mainnet

# Institutional anchoring smart contract address
CONTRACT_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
